<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Regression-Suite" verbose="3">
	<test name="Full-API-Regression">
		<groups>
			<run>
				<include name="api" />
				<include name="regression" />
			</run>
		</groups>
		<classes>
			<class name="com.xxx.javatest_demo1.api.AuthenticateBetApiTest" />
		</classes>
	</test>
	
	<test name="UI-Regression">
		<groups>
			<run>
				<include name="ui" />
			</run>
		</groups>
		<classes>
			<class name="com.xxx.javatest_demo1.ui.LoginTest" />
		</classes>
	</test>
	
	<listeners>
		<listener class-name="io.qameta.allure.testng.AllureTestNg" />
		<listener class-name="com.xxx.javatest_demo1.ScreenshotListener" />
	</listeners>
</suite>