<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Regression-Suite" verbose="1">
	<test name="Full-API-Regression">
		<groups>
			<run>
				<include name="api" />
				<include name="regression-only" />
			</run>
		</groups>
		<classes>
			<class name="com.xxx.javatest_demo1.api.BetApiTest" />
		</classes>
	</test>
	<test name="UI-Regression">
		<groups>
			<run>
				<include name="ui" />
			</run>
		</groups>
		<classes>
			<class name="com.xxx.javatest_demo1.ui.LoginTest" />
		</classes>
	</test>
</suite>